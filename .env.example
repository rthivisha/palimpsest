# PALIMPSEST Environment Configuration

# Backend engine to use: "fake" (default for dev/testing), "ollama", or "llamacpp"
PALIMPSEST_BACKEND=fake

# Ollama settings (used when PALIMPSEST_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=palimpsest

# llama-cpp-python settings (used when PALIMPSEST_BACKEND=llamacpp)
LLAMACPP_MODEL_PATH=models/palimpsest-q4_k_m.gguf
LLAMACPP_N_THREADS=4

# Verification & Loop Config
Z3_TIMEOUT_MS=3000
MAX_ITERATIONS=5
HISTORY_MODE=last
TEMP_RETRY_INCREMENT=0.1

# [CONFIRM] Model Interaction Options
# Role used for the Z3 feedback turn: "user" (default) or "tool"
TOOL_ROLE=user
# System prompt string (default empty; Qwen ChatML default prompt is disabled if empty)
SYSTEM_PROMPT=

# Optional LangSmith Tracing (Opt-in only; triggers visible warning badge in UI)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=palimpsest

# Telemetry SQLite Database
DATABASE_PATH=palimpsest.sqlite

# API Server Settings
HOST=127.0.0.1
PORT=8000
